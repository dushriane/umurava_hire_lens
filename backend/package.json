{
  "name": "hire-lens-backend",
  "version": "1.0.0",
  "description": "HireLens backend API with AI screening",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node -P tsconfig.json src/app.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "seed": "ts-node scripts/seed.ts",
    "test:smoke": "tsx tests/integration/smoke-test.ts",
    "test:integration": "tsx tests/integration/run-tests.ts",
    "test": "tsx tests/integration/run-tests.ts && tsx tests/integration/smoke-test.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.23.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/pdf-parse": "^1.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2",
    "tsx": "^4.21.0"
  }
}
